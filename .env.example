# PLC Collector v2.0 Configuration
PORT=4000
NODE_ENV=production

# ─── Data Logging Engine ─────────────────────────────
# Options: none | sqlite | postgres | mssql | oracle | mysql
# "none" = Free mode (real-time monitoring only, no historical data)
# "sqlite" = Embedded file-based (no server required)
# "postgres" = PostgreSQL (recommended for production)
# "mssql" = Microsoft SQL Server
# "oracle" = Oracle Database
# "mysql" = MySQL / MariaDB
DB_ENGINE=none

# ─── SQLite Data Settings (when DB_ENGINE=sqlite) ────
SQLITE_DATA_PATH=./data/tag_values.db

# ─── PostgreSQL Settings (when DB_ENGINE=postgres) ───
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=plc_collector
PG_USER=postgres
PG_PASSWORD=postgres

# ─── SQL Server Settings (when DB_ENGINE=mssql) ──────
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=plc_collector
MSSQL_USER=sa
MSSQL_PASSWORD=

# ─── Oracle Settings (when DB_ENGINE=oracle) ─────────
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=ORCL
ORACLE_USER=
ORACLE_PASSWORD=

# ─── MySQL Settings (when DB_ENGINE=mysql) ───────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=plc_collector
MYSQL_USER=root
MYSQL_PASSWORD=

# ─── WebSocket CORS ──────────────────────────────────
WS_CORS_ORIGIN=*
